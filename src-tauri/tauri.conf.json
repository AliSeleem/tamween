{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tamween",
  "version": "0.1.0",
  "identifier": "eg.tamween.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "تموين",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#f6f7f9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": [
          "Arabic",
          "English"
        ],
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "section": "office"
      }
    }
  }
}
